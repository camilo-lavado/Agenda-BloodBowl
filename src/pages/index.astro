---
import Base from '../layouts/Base.astro';
import { coaches } from '../data/coaches';
import { icon, raceIcon } from '../lib/icons';
import {
  rounds,
  currentRoundLabel,
  rivalId,
  fixtureId,
} from '../data/schedule';

const byId = new Map(coaches.map((c) => [c.id, c]));


const enriched = coaches.map((c) => {
  const rid = rivalId(c.id);
  return {
    ...c,
    rivalId: rid,
    rivalName: rid ? byId.get(rid)?.team_name ?? null : null,
  };
});

const roster = [...enriched].sort((a, b) =>
  a.team_name.localeCompare(b.team_name, 'es'),
);

const roundsData = rounds.map((r) => ({
  key: r.key,
  label: r.label,
  fixtures: r.pairs.map(([a, b]) => {
    const home = byId.get(a)!;
    const away = byId.get(b)!;
    return { home, away, id: fixtureId(r.key, a, b) };
  }),
}));
const currentRoundKey = roundsData[roundsData.length - 1].key;
const fixtures = roundsData[roundsData.length - 1].fixtures;
---

<Base>
  <div class="layout">
    <header class="site-head">
      <svg class="hero-art" viewBox="0 0 320 300" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M60 20 V110 Q60 130 80 130 H240 Q260 130 260 110 V20" />
          <path d="M160 130 V290" />
          <path d="M40 290 H280" opacity=".5" />
        </g>
        <g transform="translate(200 190) rotate(-28)">
          <ellipse rx="62" ry="36" fill="currentColor" opacity=".16" />
          <ellipse rx="62" ry="36" fill="none" stroke="currentColor" stroke-width="4" />
          <path d="M-20 0 H20 M-10 -9 V9 M0 -9 V9 M10 -9 V9" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
        </g>
      </svg>
      <p class="kicker"><span class="live-dot" aria-hidden="true"></span>{currentRoundLabel} en juego · FUMBBL</p>
      <h1><span>Tasting Blood VI</span><small>Contactos y calendario</small></h1>
      <ul class="hero-stats" aria-label="Resumen del torneo">
        <li><strong>{roster.length}</strong> coaches</li>
        <li><strong>{rounds.length}</strong> rondas</li>
        <li><strong>{fixtures.length}</strong> partidos por ronda</li>
      </ul>
      <ol class="hero-steps">
        <li><Fragment set:html={icon('user')} /><span><b>Toca un jugador</b>contacto y WhatsApp</span></li>
        <li><Fragment set:html={icon('calendar')} /><span><b>Toca un partido</b>día, hora y resultado</span></li>
        <li><Fragment set:html={icon('shield')} /><span><b>Elige «Soy»</b>para editar tu ficha</span></li>
      </ol>
      <input id="search" type="search" placeholder="Buscar equipo, coach o persona…" aria-label="Buscar" autocomplete="off" />
      <p class="hero-fine">Los partidos los edita cualquiera. Aquí la confianza es lo único que sobrevive a la ronda.</p>
      <p id="status" class="banner" hidden></p>
    </header>

    <div class="toolbar">
      <label class="me-pick">
        <span>Soy</span>
        <select id="me-select" aria-label="Elige tu coach">
          <option value="">— elige tu coach —</option>
          {roster.map((c) => (
            <option value={c.id}>{c.fumbbl_coach} · {c.team_name}</option>
          ))}
        </select>
      </label>
      <div class="progress" id="progress">
        <div class="progress-track"><span class="progress-fill" id="progress-fill"></span></div>
        <span class="progress-text" id="progress-text">— / {roster.length} con WhatsApp</span>
      </div>
    </div>

    <section class="mi-partido" id="mi-partido" hidden>
      <p class="mp-eyebrow">Tu partido · {currentRoundLabel}</p>
      <p class="mp-teams"></p>
      <p class="mp-status"></p>
      <div class="mp-actions">
        <a class="wa-btn mp-wa disabled" role="button" aria-disabled="true" target="_blank" rel="noopener noreferrer">Escribir al rival</a>
        <button class="save-btn mp-open" type="button">Ver partido</button>
      </div>
    </section>

    <section class="section" id="sec-results" hidden>
      <h2>Resultados <span class="count" id="results-count"></span></h2>
      <ul class="roster" id="results-list"></ul>
      <p class="results-empty" id="results-empty" hidden>Nadie coincide. Quizá ya lo sacaron en camilla.</p>
    </section>

    <section class="section" id="sec-round">
      <h2>
        Partidos
        <span class="count" id="round-count"></span>
        <span class="pill" id="round-pending" data-tone="pending"></span>
      </h2>
      <div class="round-carousel">
        <div class="rc-head">
          <button class="rc-nav rc-prev" type="button" aria-label="Ronda anterior" disabled={roundsData.length < 2}><Fragment set:html={icon('chevron-left')} /></button>
          <span class="rc-label" id="round-carousel-label">{currentRoundLabel}</span>
          <button class="rc-nav rc-next" type="button" aria-label="Ronda siguiente" disabled={roundsData.length < 2}><Fragment set:html={icon('chevron-right')} /></button>
        </div>
        <div class="rc-viewport">
          {roundsData.map((r, i) => (
            <div class="fixtures round-panel" data-round={r.key} hidden={i !== roundsData.length - 1}>
              {r.fixtures.map((fx) => (
                <div class="fixture" data-fixture={fx.id}>
                  <button class="fx-side" type="button" data-id={fx.home.id} data-open={fx.home.id}>
                    <span class="status-dot" data-state="empty" aria-hidden="true"></span>
                    <span class="fx-team">{fx.home.team_name}</span>
                    <span class="fx-coach js-name">{fx.home.fumbbl_coach}</span>
                  </button>
                  <button class="fx-center" type="button" data-match={fx.id}
                    aria-label={`Partido ${fx.home.team_name} contra ${fx.away.team_name}`}>
                    <span class="fx-vs">vs</span>
                    <span class="fx-info">agendar</span>
                  </button>
                  <button class="fx-side right" type="button" data-id={fx.away.id} data-open={fx.away.id}>
                    <span class="status-dot" data-state="empty" aria-hidden="true"></span>
                    <span class="fx-team">{fx.away.team_name}</span>
                    <span class="fx-coach js-name">{fx.away.fumbbl_coach}</span>
                  </button>
                  <button class="fx-ticker" type="button" data-match={fx.id} hidden aria-label="Ver partido">
                    <span class="fx-ticker-track"></span>
                  </button>
                </div>
              ))}
            </div>
          ))}
        </div>
        {roundsData.length > 1 && (
          <div class="rc-dots" id="rc-dots">
            {roundsData.map((r, i) => (
              <button
                class="rc-dot"
                type="button"
                data-round={r.key}
                aria-label={r.label}
                aria-current={i === roundsData.length - 1 ? 'true' : undefined}
              ></button>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="section podium-sec" id="sec-podium" hidden>
      <h2><span class="chev" aria-hidden="true" set:html={icon('trophy')}></span>Podio final</h2>
      <div class="podium" id="podium"></div>
      <ul class="awards" id="awards"></ul>
    </section>

    <section class="section" id="sec-standings">
      <h2 class="collapsible open" id="standings-toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="standings-wrap">
        <span class="chev" aria-hidden="true" set:html={icon('chevron-right')}></span>Clasificación <span class="count" id="standings-count"></span>
      </h2>
      <div id="standings-wrap">
      <div class="table-wrap">
        <table class="standings">
          <thead>
            <tr>
              <th class="c-pos">#</th>
              <th class="c-team">Equipo</th>
              <th>PJ</th>
              <th class="c-gep">G-E-P</th>
              <th>TD</th>
              <th class="c-cas">Bajas</th>
              <th class="c-pts">Pts</th>
            </tr>
          </thead>
          <tbody id="standings-body"></tbody>
        </table>
      </div>
      <p class="results-empty" id="standings-empty">Aún no hay resultados. Todos siguen invictos y con las rodillas intactas.</p>
      </div>
    </section>

    <section class="section" id="sec-leaders">
      <h2 class="collapsible open" id="leaders-toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="leaders-body">
        <span class="chev" aria-hidden="true" set:html={icon('chevron-right')}></span>Líderes <span class="count" id="leaders-count"></span>
      </h2>
      <div id="leaders-body">
      <div class="leaders-grid" hidden>
        <div class="leader-col">
          <p class="leader-title"><Fragment set:html={icon('goal')} /> Más touchdowns</p>
          <ol class="leader-list" id="leaders-td"></ol>
        </div>
        <div class="leader-col">
          <p class="leader-title"><Fragment set:html={icon('swords')} /> Más bajas</p>
          <ol class="leader-list" id="leaders-cas"></ol>
        </div>
        <div class="leader-col">
          <p class="leader-title"><Fragment set:html={icon('target')} /> Más pasador</p>
          <ol class="leader-list" id="leaders-comp"></ol>
        </div>
        <div class="leader-col">
          <p class="leader-title"><Fragment set:html={icon('star')} /> MVP acumulado</p>
          <ol class="leader-list" id="leaders-mvp"></ol>
        </div>
      </div>
      <p class="results-empty" id="leaders-empty">Aún no hay marcadores. La gloria tendrá que esperar.</p>
      </div>
    </section>

    <section class="section" id="sec-fallen">
      <h2 class="collapsible" id="fallen-toggle" role="button" tabindex="0" aria-expanded="false" aria-controls="fallen-body">
        <span class="chev" aria-hidden="true" set:html={icon('chevron-right')}></span>Salón de los caídos <span class="count" id="fallen-count"></span>
      </h2>
      <div id="fallen-body" hidden>
        <div class="leaders-grid fallen-summary" id="fallen-summary" hidden>
          <div class="leader-col">
            <p class="leader-title"><Fragment set:html={icon('droplet')} /> Equipos más golpeados</p>
            <ol class="leader-list" id="fallen-teams"></ol>
          </div>
          <div class="leader-col">
            <p class="leader-title"><Fragment set:html={icon('clover')} /> Jugadores más yetas</p>
            <ol class="leader-list" id="fallen-players"></ol>
          </div>
        </div>
        <button type="button" class="sub-toggle" id="fallen-all-toggle" aria-expanded="false" aria-controls="fallen-list" hidden>
          <span class="chev" aria-hidden="true" set:html={icon('chevron-right')}></span><span id="fallen-all-label">Ver todas las bajas</span>
        </button>
        <ul class="fallen-list" id="fallen-list" hidden></ul>
        <p class="results-empty" id="fallen-empty">Nadie ha caído... todavía. Los cementerios son pacientes.</p>
      </div>
    </section>

    <section class="section" id="sec-brutal">
      <h2 class="collapsible" id="brutal-toggle" role="button" tabindex="0" aria-expanded="false" aria-controls="brutal-body">
        <span class="chev" aria-hidden="true" set:html={icon('chevron-right')}></span>Brutalistas y asesinos <span class="count" id="brutal-count"></span>
      </h2>
      <div id="brutal-body" hidden>
        <div class="leaders-grid" id="brutal-grid" hidden>
          <div class="leader-col">
            <p class="leader-title"><Fragment set:html={icon('axe')} /> Brutalistas (más bajas causadas)</p>
            <ol class="leader-list" id="brutal-players"></ol>
          </div>
          <div class="leader-col">
            <p class="leader-title"><Fragment set:html={icon('skull')} /> Asesinos (más muertes causadas)</p>
            <ol class="leader-list" id="brutal-killers"></ol>
          </div>
        </div>
        <p class="results-empty" id="brutal-empty">Aún no hay bajas. Los árbitros no vieron nada, seguro.</p>
      </div>
    </section>

    <section class="section" id="sec-roster">
      <h2 class="collapsible open" id="roster-toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="roster-wrap">
        <span class="chev" aria-hidden="true" set:html={icon('chevron-right')}></span>Jugadores <span class="count">{roster.length}</span>
      </h2>
      <div id="roster-wrap">
      <p class="legend">
        <span><i class="status-dot" data-state="ok" aria-hidden="true"></i> con WhatsApp</span>
        <span><i class="status-dot" data-state="partial" aria-hidden="true"></i> solo nombre</span>
        <span><i class="status-dot" data-state="empty" aria-hidden="true"></i> sin datos</span>
      </p>
      <ul class="roster">
        {roster.map((c) => (
          <li>
            <button class="roster-item" type="button" data-id={c.id} data-open={c.id}>
              <span class="status-dot" data-state="empty" aria-hidden="true"></span>
              <span class="roster-main">
                <span class="js-name">{c.fumbbl_coach}</span>
                <span class="roster-sub">{c.team_name} · <Fragment set:html={raceIcon(c.race)} /> {c.race}</span>
              </span>
              <span class="roster-handle">@{c.fumbbl_coach}</span>
            </button>
          </li>
        ))}
      </ul>
      </div>
    </section>

    <footer class="site-foot">
      <p>Sin registro ni contraseñas. Los datos se guardan en Supabase. Hecho para el grupo de Tasting Blood VI.</p>
      <p class="credit">Desarrollado por <a href="https://www.caladev.page/" target="_blank" rel="noopener">CalaDev</a></p>
    </footer>
  </div>

  <!-- ==================== Ficha de contacto ==================== -->
  <dialog id="detail" class="detail">
    <div class="d-box">
      <button class="d-close" type="button" aria-label="Cerrar"><Fragment set:html={icon('x')} /></button>
      <p class="d-eyebrow">Contacto</p>
      <h2 class="d-team"></h2>
      <p class="d-meta"></p>
      <p class="d-coachline">Coach FUMBBL: <strong class="d-coach"></strong></p>

      <button class="d-rival" type="button" hidden>
        <span>{currentRoundLabel} vs</span>
        <strong class="d-rival-name"></strong>
        <span class="d-rival-go">ver contacto →</span>
      </button>

      <label>
        Quién es
        <input class="f-realname" type="text" placeholder="Sin asignar" autocomplete="off" />
      </label>
      <label>
        WhatsApp
        <input class="f-whatsapp" type="tel" inputmode="numeric" placeholder="9 1234 5678" autocomplete="off" />
        <small>Chile: escribe solo <strong>9&nbsp;1234&nbsp;5678</strong> (añadimos el 56). Otro país: número completo con código, sin «+».</small>
      </label>
      <label>
        Notas
        <input class="f-notes" type="text" placeholder="Horario, zona horaria…" autocomplete="off" />
      </label>

      <p class="d-lock-note" hidden></p>
      <div class="d-actions">
        <button class="save-btn" type="button">Guardar</button>
        <a class="wa-btn disabled" role="button" aria-disabled="true" target="_blank" rel="noopener noreferrer">Abrir WhatsApp</a>
      </div>
      <div class="d-links">
        <button class="linkbtn copy-num" type="button">Copiar número</button>
        <button class="linkbtn copy-link" type="button">Copiar enlace</button>
      </div>
      <div class="d-foot">
        <span class="updated"></span>
        <span class="card-status" role="status"></span>
      </div>
    </div>
  </dialog>

  <!-- ==================== Ficha de partido ==================== -->
  <dialog id="match" class="detail">
    <div class="d-box">
      <button class="m-close" type="button" aria-label="Cerrar"><Fragment set:html={icon('x')} /></button>
      <p class="d-eyebrow" id="match-round-label">{currentRoundLabel}</p>
      <h2 class="m-title"></h2>
      <p class="m-recap" hidden></p>
      <p class="m-played" hidden></p>

      <label>
        Día y hora
        <input class="m-datetime" type="datetime-local" />
      </label>

      <fieldset class="m-score">
        <legend>Resultado · local – visitante</legend>
        <div class="m-score-row">
          <span class="m-score-team m-home"></span>
          <span class="m-score-label">TD</span>
          <input class="m-td-home" type="number" min="0" max="30" inputmode="numeric" />
          <span class="m-score-sep">–</span>
          <input class="m-td-away" type="number" min="0" max="30" inputmode="numeric" />
          <span class="m-score-team m-away"></span>
        </div>
        <div class="m-score-row">
          <span class="m-score-team"></span>
          <span class="m-score-label">Bajas</span>
          <input class="m-cas-home" type="number" min="0" max="30" inputmode="numeric" />
          <span class="m-score-sep">–</span>
          <input class="m-cas-away" type="number" min="0" max="30" inputmode="numeric" />
          <span class="m-score-team"></span>
        </div>
      </fieldset>

      <label>
        Nota
        <input class="m-note" type="text" placeholder="MVP, incidencias, link a la repetición…" autocomplete="off" />
      </label>

      <div class="d-actions">
        <button class="m-save" type="button">Guardar</button>
      </div>

      <p class="m-remind-label">Recordar por WhatsApp</p>
      <div class="d-actions">
        <a class="wa-btn m-remind-home disabled" role="button" aria-disabled="true" target="_blank" rel="noopener noreferrer"></a>
        <a class="wa-btn m-remind-away disabled" role="button" aria-disabled="true" target="_blank" rel="noopener noreferrer"></a>
      </div>

      <div class="d-links">
        <a class="linkbtn m-fumbbl-link" hidden target="_blank" rel="noopener noreferrer">Ver en FUMBBL <Fragment set:html={icon('external-link')} /></a>
      </div>

      <div class="d-foot">
        <span class="m-updated"></span>
        <span class="m-status" role="status"></span>
      </div>
    </div>
  </dialog>

  <script set:html={`
    window.__COACHES__ = ${JSON.stringify(enriched)};
    window.__ROUNDS__ = ${JSON.stringify(
      roundsData.map((r) => ({
        key: r.key,
        label: r.label,
        fixtures: r.fixtures.map((fx) => ({
          id: fx.id,
          home_id: fx.home.id,
          away_id: fx.away.id,
          home_team: fx.home.team_name,
          away_team: fx.away.team_name,
        })),
      })),
    )};
    window.__FIXTURES_PER_ROUND__ = ${fixtures.length};
    window.__ROUND__ = ${JSON.stringify(currentRoundLabel)};
    window.__ROUND_KEY__ = ${JSON.stringify(currentRoundKey)};
  `} />
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { icon, raceIcon } from '../lib/icons';

  const SUPABASE_URL = (import.meta.env.PUBLIC_SUPABASE_URL ?? '')
    .trim()
    .replace(/^["']|["']$/g, '')
    .replace(/\/rest\/v1\/?$/, '')
    .replace(/\/+$/, '');
  const SUPABASE_KEY = (import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '')
    .trim()
    .replace(/^["']|["']$/g, '');

  const supabase =
    SUPABASE_URL && SUPABASE_KEY ? createClient(SUPABASE_URL, SUPABASE_KEY) : null;

  interface CoachInfo {
    id: string;
    team_name: string;
    fumbbl_coach: string;
    race: string;
    rivalId: string | null;
    rivalName: string | null;
  }
  interface Row {
    id: string;
    real_name: string | null;
    whatsapp: string | null;
    notes: string | null;
    updated_at?: string | null;
  }
  interface FixtureInfo {
    id: string;
    home_id: string;
    away_id: string;
    home_team: string;
    away_team: string;
  }
  interface RoundInfo {
    key: string;
    label: string;
    fixtures: FixtureInfo[];
  }
  interface CasualtyEvent {
    team_id: string;
    player: string;
    outcome: string;
  }
  interface MatchRow {
    id: string;
    round?: string | null;
    home_id?: string | null;
    away_id?: string | null;
    home_team?: string | null;
    away_team?: string | null;
    scheduled_at: string | null;
    td_home: number | null;
    td_away: number | null;
    cas_home: number | null;
    cas_away: number | null;
    comp_home?: number | null;
    comp_away?: number | null;
    mvp_home?: string | null;
    mvp_away?: string | null;
    played_at?: string | null;
    fumbbl_match_id?: string | null;
    casualties?: CasualtyEvent[] | null;
    bashers?: { team_id: string; player: string; cas: number }[] | null;
    note: string | null;
    updated_at?: string | null;
  }

  const COACHES: CoachInfo[] = (window as any).__COACHES__ ?? [];
  const ROUNDS: RoundInfo[] = (window as any).__ROUNDS__ ?? [];
  const ROUND: string = (window as any).__ROUND__ ?? '';
  const ROUND_KEY: string = (window as any).__ROUND_KEY__ ?? '';
  const FIXTURES: FixtureInfo[] = ROUNDS.flatMap((r) => r.fixtures);
  const CURRENT_FIXTURES: FixtureInfo[] =
    ROUNDS.find((r) => r.key === ROUND_KEY)?.fixtures ?? [];
  const cmap = new Map(COACHES.map((c) => [c.id, c]));
  const FIXTURES_PER_ROUND: number = (window as any).__FIXTURES_PER_ROUND__ ?? 7;
  const fmap = new Map(FIXTURES.map((fx) => [fx.id, fx]));
  const roundOfFixture = new Map<string, RoundInfo>();
  ROUNDS.forEach((r) => r.fixtures.forEach((fx) => roundOfFixture.set(fx.id, r)));
  let activeRoundKey = ROUND_KEY;
  const state = new Map<string, Row>();
  const mstate = new Map<string, MatchRow>();

  // "Soy" — se recuerda solo en este dispositivo
  const ME_KEY = 'tb6_me';
  function getMe(): string {
    try {
      return localStorage.getItem(ME_KEY) || '';
    } catch {
      return '';
    }
  }
  function saveMe(v: string) {
    try {
      if (v) localStorage.setItem(ME_KEY, v);
      else localStorage.removeItem(ME_KEY);
    } catch {}
  }
  let me = getMe();

  // Permisos (solo en la interfaz): cada quien edita su propia ficha;
  // kroszover (Camilo) puede editar todas. Los partidos son públicos.
  const ADMIN_ID = 'la-orden-del-santo-pernil';
  const canEditCoach = (id: string) => me === id || me === ADMIN_ID;

  const banner = document.getElementById('status') as HTMLParagraphElement;
  if (!supabase) {
    banner.hidden = false;
    banner.innerHTML =
      icon('triangle-alert') + ' Supabase no está configurado. Añade <code>PUBLIC_SUPABASE_URL</code> y <code>PUBLIC_SUPABASE_ANON_KEY</code> y vuelve a desplegar. Puedes escribir, pero <strong>no se guarda</strong>.';
  }

  // Normaliza a formato internacional sin «+». Casi todos son Chile (+56);
  // un móvil chileno nacional son 9 dígitos empezando por 9.
  function normalize(raw: string | null | undefined): string {
    let d = (raw ?? '').replace(/\D+/g, '');
    if (!d) return '';
    if (d.startsWith('00')) d = d.slice(2);
    if (d.length === 9 && d.startsWith('9')) d = '56' + d;
    else if (d.length === 8) d = '569' + d;
    return d;
  }

  function waHref(number: string, msg: string): string | null {
    const d = normalize(number);
    if (d.length < 8) return null;
    return `https://wa.me/${d}?text=${encodeURIComponent(msg)}`;
  }

  function fmtDateTime(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toLocaleString('es-ES', {
      weekday: 'short',
      day: '2-digit',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  // ISO -> value para <input type="datetime-local"> en hora local
  function toLocalInput(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(
      d.getHours(),
    )}:${pad(d.getMinutes())}`;
  }

  function statusOf(id: string): 'ok' | 'partial' | 'empty' {
    const r = state.get(id);
    if (r?.whatsapp) return 'ok';
    if (r?.real_name) return 'partial';
    return 'empty';
  }

  function paintList() {
    document.querySelectorAll<HTMLElement>('[data-id]').forEach((el) => {
      const id = el.dataset.id!;
      const dot = el.querySelector<HTMLElement>('.status-dot');
      if (dot) dot.dataset.state = statusOf(id);
      const nameEl = el.querySelector<HTMLElement>('.js-name');
      if (nameEl) {
        const r = state.get(id);
        nameEl.textContent = r?.real_name || cmap.get(id)!.fumbbl_coach;
      }
      el.classList.toggle('is-me', !!me && id === me);
    });
    paintProgress();
  }

  function paintProgress() {
    const total = COACHES.length;
    const withWa = COACHES.filter((c) => state.get(c.id)?.whatsapp).length;
    const fill = document.getElementById('progress-fill');
    const text = document.getElementById('progress-text');
    if (fill) {
      fill.style.width = `${total ? (withWa / total) * 100 : 0}%`;
      fill.classList.toggle('full', withWa === total && total > 0);
    }
    if (text) text.textContent = `${withWa} / ${total} con WhatsApp`;
  }

  // Distintivo por tipo de nombre: equipo (escudo), coach (persona), jugador (camiseta).
  const ent = (kind: 'team' | 'coach' | 'player', text: string) =>
    `<span class="ent ent-${kind}">${icon(kind === 'team' ? 'shield' : kind === 'coach' ? 'user' : 'shirt')}<span>${esc(text)}</span></span>`;

  function coachLabel(id: string): string {
    const c = cmap.get(id);
    if (!c) return id;
    return state.get(id)?.real_name || c.fumbbl_coach;
  }


  // -------- Clasificación --------
  type FStand = {
    team_id: string; position: number; games: number; wins: number; draws: number; losses: number;
    td_for: number; td_against: number; cas_for: number; cas_against: number; score: number;
  };
  let fumbblStandings: FStand[] = [];

  // -------- Podio: aparece cuando están los resultados de las 4 rondas --------
  const TOTAL_ROUNDS = 4;
  function tournamentDone(): boolean {
    if (new URLSearchParams(location.search).has('podio')) return true; // vista previa
    const perRound = new Map<string, number>();
    for (const m of mstate.values()) {
      if (m.td_home != null && m.td_away != null) perRound.set(m.round, (perRound.get(m.round) ?? 0) + 1);
    }
    const per = FIXTURES_PER_ROUND;
    return perRound.size >= TOTAL_ROUNDS && [...perRound.values()].every((n) => n >= per);
  }

  function renderPodium(rows: { id: string; pts: number; tdd: number; casd: number }[]) {
    const sec = document.getElementById('sec-podium');
    const box = document.getElementById('podium');
    const awards = document.getElementById('awards');
    if (!sec || !box || !awards) return;
    const done = tournamentDone() && rows.length >= 3;
    sec.hidden = !done;
    if (!done) return;

    // Orden visual: 2º, 1º, 3º
    const order = [1, 0, 2];
    const medal = ['oro', 'plata', 'bronce'];
    box.innerHTML = order
      .map((i) => {
        const r = rows[i];
        const c = cmap.get(r.id);
        if (!c) return '';
        return (
          `<button type="button" class="pod pod-${i + 1} ${medal[i]}" data-open="${esc(r.id)}">` +
          `<span class="pod-medal">${icon('trophy')}</span>` +
          `<span class="pod-team">${esc(c.team_name)}</span>` +
          `<span class="pod-coach">${ent('coach', coachLabel(r.id))}</span>` +
          `<span class="pod-pts">${r.pts} pts</span>` +
          `<span class="pod-step"><b>${i + 1}</b></span></button>`
        );
      })
      .join('');

    // Premios: máximo anotador, brutalista, equipo más golpeado
    const td = new Map<string, number>();
    const bash = new Map<string, { player: string; teamId: string; cas: number }>();
    const hit = new Map<string, number>();
    for (const m of mstate.values()) {
      if (m.home_id && m.td_home != null) td.set(m.home_id, (td.get(m.home_id) ?? 0) + m.td_home);
      if (m.away_id && m.td_away != null) td.set(m.away_id, (td.get(m.away_id) ?? 0) + m.td_away);
      for (const b of m.bashers ?? []) {
        const k = `${b.team_id}::${b.player}`;
        const cur = bash.get(k) ?? { player: b.player, teamId: b.team_id, cas: 0 };
        cur.cas += b.cas;
        bash.set(k, cur);
      }
      for (const ev of m.casualties ?? []) hit.set(ev.team_id, (hit.get(ev.team_id) ?? 0) + 1);
    }
    const best = <T,>(it: Iterable<[string, T]>, val: (v: T) => number) =>
      [...it].sort((a, b) => val(b[1]) - val(a[1]))[0];
    const items: string[] = [];
    const tdBest = best(td.entries(), (v) => v);
    if (tdBest) items.push(`<li>${icon('goal')}<span><b>Más touchdowns</b>${ent('team', cmap.get(tdBest[0])?.team_name ?? tdBest[0])} · ${tdBest[1]}</span></li>`);
    const bBest = best(bash.entries(), (v) => v.cas);
    if (bBest) items.push(`<li>${icon('axe')}<span><b>Brutalista del torneo</b>${ent('player', bBest[1].player)} · ${bBest[1].cas} bajas</span></li>`);
    const hBest = best(hit.entries(), (v) => v);
    if (hBest) items.push(`<li>${icon('skull')}<span><b>Saco de boxeo</b>${ent('team', cmap.get(hBest[0])?.team_name ?? hBest[0])} · ${hBest[1]} bajas sufridas</span></li>`);
    awards.innerHTML = items.join('');
  }

  function renderStandings() {
    const body = document.getElementById('standings-body');
    const empty = document.getElementById('standings-empty');
    const count = document.getElementById('standings-count');
    if (!body) return;

    type S = {
      id: string; pj: number; g: number; e: number; p: number;
      tdf: number; tdc: number; casf: number; casc: number; pts: number;
    };
    const T = new Map<string, S>();
    const ensure = (id: string) => {
      let s = T.get(id);
      if (!s) {
        s = { id, pj: 0, g: 0, e: 0, p: 0, tdf: 0, tdc: 0, casf: 0, casc: 0, pts: 0 };
        T.set(id, s);
      }
      return s;
    };

    for (const m of mstate.values()) {
      if (m.td_home == null && m.td_away == null) continue;
      if (!m.home_id || !m.away_id) continue;
      const th = m.td_home ?? 0;
      const ta = m.td_away ?? 0;
      const ch = m.cas_home ?? 0;
      const ca = m.cas_away ?? 0;
      const H = ensure(m.home_id);
      const A = ensure(m.away_id);
      H.pj++; A.pj++;
      H.tdf += th; H.tdc += ta; A.tdf += ta; A.tdc += th;
      H.casf += ch; H.casc += ca; A.casf += ca; A.casc += ch;
      if (th > ta) { H.g++; A.p++; H.pts += 3; }
      else if (ta > th) { A.g++; H.p++; A.pts += 3; }
      else { H.e++; A.e++; H.pts++; A.pts++; }
    }

    // Si el sincronizador ya copió la tabla oficial de FUMBBL, se usa tal cual.
    const official = fumbblStandings
      .filter((f) => cmap.has(f.team_id))
      .sort((a, b) => a.position - b.position)
      .map((f) => ({
        id: f.team_id, pj: f.games, g: f.wins, e: f.draws, p: f.losses,
        tdf: f.td_for, tdc: f.td_against, casf: f.cas_for, casc: f.cas_against,
        pts: f.score, tdd: f.td_for - f.td_against, casd: f.cas_for - f.cas_against,
      }));

    const rows = official.length ? official : [...T.values()]
      .map((s) => ({ ...s, tdd: s.tdf - s.tdc, casd: s.casf - s.casc }))
      .sort(
        (a, b) =>
          b.pts - a.pts ||
          b.tdd - a.tdd ||
          b.casd - a.casd ||
          b.tdf - a.tdf ||
          (cmap.get(a.id)?.team_name ?? '').localeCompare(
            cmap.get(b.id)?.team_name ?? '',
            'es',
          ),
      );

    renderPodium(rows);
    if (count) count.textContent = rows.length ? String(rows.length) : '';
    if (empty) empty.hidden = rows.length > 0;

    const sign = (n: number) => (n > 0 ? `+${n}` : String(n));
    body.innerHTML = rows
      .map((s, i) => {
        const c = cmap.get(s.id)!;
        return (
          `<tr data-open="${esc(s.id)}"${s.id === me ? ' class="is-me"' : ''}>` +
          `<td class="c-pos">${i + 1}</td>` +
          `<td class="c-team"><span class="st-team">${ent('team', c.team_name)}</span>` +
          `<span class="st-coach">${ent('coach', '@' + c.fumbbl_coach)}</span></td>` +
          `<td>${s.pj}</td>` +
          `<td class="c-gep">${s.g}-${s.e}-${s.p}</td>` +
          `<td>${sign(s.tdd)}</td>` +
          `<td class="c-cas">${sign(s.casd)}</td>` +
          `<td class="c-pts">${s.pts}</td>` +
          `</tr>`
        );
      })
      .join('');
  }

  // -------- Líderes: TD, bajas, MVP --------
  function renderLeaders() {
    const tdList = document.getElementById('leaders-td');
    const casList = document.getElementById('leaders-cas');
    const compList = document.getElementById('leaders-comp');
    const mvpList = document.getElementById('leaders-mvp');
    const empty = document.getElementById('leaders-empty');
    const count = document.getElementById('leaders-count');
    const grid = document.querySelector<HTMLElement>('.leaders-grid');
    if (!tdList || !casList || !compList || !mvpList) return;

    const tdOf = new Map<string, number>();
    const casOf = new Map<string, number>();
    const compOf = new Map<string, number>();
    const mvpOf = new Map<string, number>(); // clave: "<teamId>::<jugador>"
    let anyResult = false;

    for (const m of mstate.values()) {
      if (!m.home_id || !m.away_id) continue;
      if (m.td_home == null && m.td_away == null) continue;
      anyResult = true;
      tdOf.set(m.home_id, (tdOf.get(m.home_id) ?? 0) + (m.td_home ?? 0));
      tdOf.set(m.away_id, (tdOf.get(m.away_id) ?? 0) + (m.td_away ?? 0));
      casOf.set(m.home_id, (casOf.get(m.home_id) ?? 0) + (m.cas_home ?? 0));
      casOf.set(m.away_id, (casOf.get(m.away_id) ?? 0) + (m.cas_away ?? 0));
      if (m.comp_home != null) compOf.set(m.home_id, (compOf.get(m.home_id) ?? 0) + m.comp_home);
      if (m.comp_away != null) compOf.set(m.away_id, (compOf.get(m.away_id) ?? 0) + m.comp_away);
      if (m.mvp_home) {
        const k = `${m.home_id}::${m.mvp_home}`;
        mvpOf.set(k, (mvpOf.get(k) ?? 0) + 1);
      }
      if (m.mvp_away) {
        const k = `${m.away_id}::${m.mvp_away}`;
        mvpOf.set(k, (mvpOf.get(k) ?? 0) + 1);
      }
    }

    if (grid) grid.hidden = !anyResult;
    if (empty) empty.hidden = anyResult;
    if (count) count.textContent = anyResult ? '' : '';

    const top = (map: Map<string, number>, n: number) =>
      [...map.entries()].sort((a, b) => b[1] - a[1]).slice(0, n);

    const teamRow = (id: string, n: number, unit: string) => {
      const c = cmap.get(id);
      if (!c) return '';
      return (
        `<li data-open="${esc(id)}"><span class="leader-name">${ent('coach', coachLabel(id))}` +
        `<small>${ent('team', c.team_name)}</small></span><span class="leader-num">${n}${unit}</span></li>`
      );
    };

    tdList.innerHTML = top(tdOf, 5)
      .map(([id, n]) => teamRow(id, n, ''))
      .join('') || '<li class="leader-empty">—</li>';
    casList.innerHTML = top(casOf, 5)
      .map(([id, n]) => teamRow(id, n, ''))
      .join('') || '<li class="leader-empty">—</li>';
    compList.innerHTML = top(compOf, 5)
      .filter(([, n]) => n > 0)
      .map(([id, n]) => teamRow(id, n, ''))
      .join('') || '<li class="leader-empty">—</li>';
    mvpList.innerHTML =
      top(mvpOf, 5)
        .filter(([, n]) => n >= 1)
        .map(([key, n]) => {
          const [teamId, player] = key.split('::');
          const c = cmap.get(teamId);
          if (!c) return '';
          return (
            `<li data-open="${esc(teamId)}"><span class="leader-name">${ent('player', player)}` +
            `<small>${ent('team', c.team_name)}</small></span><span class="leader-num">${n}×</span></li>`
          );
        })
        .join('') || '<li class="leader-empty">—</li>';
  }

  // -------- Salón de los caídos --------
  function outcomeIcon(outcome: string): string {
    if (outcome.startsWith('Dead')) return icon('skull', 'ico-dead');
    if (outcome.startsWith('Seriously Hurt')) return icon('heart-crack', 'ico-hurt');
    if (outcome.startsWith('Badly Hurt')) return icon('bandage', 'ico-hurt');
    return icon('hospital', 'ico-hurt');
  }

  function renderFallen() {
    const list = document.getElementById('fallen-list');
    const empty = document.getElementById('fallen-empty');
    const count = document.getElementById('fallen-count');
    if (!list) return;

    type Event = { teamId: string; player: string; outcome: string; when: string | null; round: string };
    const events: Event[] = [];
    for (const m of mstate.values()) {
      if (!m.casualties?.length) continue;
      for (const ev of m.casualties) {
        events.push({
          teamId: ev.team_id,
          player: ev.player,
          outcome: ev.outcome,
          when: m.played_at ?? null,
          round: m.round ?? '',
        });
      }
    }
    events.sort((a, b) => (b.when ?? '').localeCompare(a.when ?? ''));

    const isDead = (o: string) => o.startsWith('Dead');
    const deaths = events.filter((e) => isDead(e.outcome)).length;
    if (count) {
      count.innerHTML = events.length ? `${events.length} · ${icon('skull', 'ico-dead')} ${deaths}` : '';
    }
    if (empty) empty.hidden = events.length > 0;
    const allToggle = document.getElementById('fallen-all-toggle');
    const allLabel = document.getElementById('fallen-all-label');
    if (allToggle) allToggle.hidden = events.length === 0;
    if (allLabel) allLabel.textContent = `Ver todas las bajas (${events.length})`;

    // ---- Acumulados: equipos más golpeados / jugadores más yetas ----
    const teamsEl = document.getElementById('fallen-teams');
    const playersEl = document.getElementById('fallen-players');
    const summaryEl = document.getElementById('fallen-summary');
    if (summaryEl) summaryEl.hidden = events.length === 0;

    type Agg = { dead: number; hurt: number };
    const byTeam = new Map<string, Agg>();
    const byPlayer = new Map<string, Agg & { player: string; teamId: string }>();
    for (const ev of events) {
      const dead = isDead(ev.outcome);
      const t = byTeam.get(ev.teamId) ?? { dead: 0, hurt: 0 };
      if (dead) t.dead++;
      else t.hurt++;
      byTeam.set(ev.teamId, t);
      const pk = `${ev.teamId}::${ev.player}`;
      const p = byPlayer.get(pk) ?? { dead: 0, hurt: 0, player: ev.player, teamId: ev.teamId };
      if (dead) p.dead++;
      else p.hurt++;
      byPlayer.set(pk, p);
    }
    const score = (a: Agg) => a.dead * 2 + a.hurt; // la muerte pesa el doble
    const chips = (a: Agg) =>
      (a.dead ? `<span class="fchip dead">${icon('skull')} ${a.dead}</span>` : '') +
      (a.hurt ? `<span class="fchip hurt">${icon('heart-crack')} ${a.hurt}</span>` : '');

    if (teamsEl) {
      teamsEl.innerHTML = [...byTeam.entries()]
        .sort((a, b) => score(b[1]) - score(a[1]))
        .slice(0, 5)
        .map(([id, a]) => {
          const c = cmap.get(id);
          return (
            `<li data-open="${esc(id)}"><span class="leader-name">${ent('team', c?.team_name ?? id)}` +
            `<small>${ent('coach', coachLabel(id))}</small></span><span class="fchips">${chips(a)}</span></li>`
          );
        })
        .join('');
    }
    if (playersEl) {
      playersEl.innerHTML = [...byPlayer.values()]
        .sort((a, b) => score(b) - score(a) || a.player.localeCompare(b.player))
        .slice(0, 5)
        .map((p) => {
          const c = cmap.get(p.teamId);
          return (
            `<li data-open="${esc(p.teamId)}"><span class="leader-name">${ent('player', p.player)}` +
            `<small>${ent('team', c?.team_name ?? '')}</small></span><span class="fchips">${chips(p)}</span></li>`
          );
        })
        .join('');
    }

    list.innerHTML = events
      .map((ev) => {
        const c = cmap.get(ev.teamId);
        return (
          `<li data-open="${esc(ev.teamId)}">` +
          `<span class="fallen-ico" aria-hidden="true">${outcomeIcon(ev.outcome)}</span>` +
          `<span class="fallen-txt"><strong>${ent('player', ev.player)}</strong> — ${esc(ev.outcome)}` +
          `<small>${ent('team', c?.team_name ?? '')} · ${esc(ev.round)}</small></span>` +
          `</li>`
        );
      })
      .join('');
  }

  // -------- Brutalistas (bajas causadas por jugador) y asesinos (muertes por equipo) --------
  function renderBrutal() {
    const grid = document.getElementById('brutal-grid');
    const empty = document.getElementById('brutal-empty');
    const count = document.getElementById('brutal-count');
    const playersEl = document.getElementById('brutal-players');
    const killersEl = document.getElementById('brutal-killers');
    if (!grid || !playersEl || !killersEl) return;

    const byPlayer = new Map<string, { player: string; teamId: string; cas: number }>();
    let totalCas = 0;
    const kills = new Map<string, number>();
    for (const m of mstate.values()) {
      for (const b of m.bashers ?? []) {
        const k = `${b.team_id}::${b.player}`;
        const cur = byPlayer.get(k) ?? { player: b.player, teamId: b.team_id, cas: 0 };
        cur.cas += b.cas;
        byPlayer.set(k, cur);
        totalCas += b.cas;
      }
      // Muerte en las bajas de un equipo = muerte causada por su rival.
      if (!m.home_id || !m.away_id) continue;
      for (const ev of m.casualties ?? []) {
        if (!/^Dead/i.test(ev.outcome)) continue;
        const killer = ev.team_id === m.home_id ? m.away_id : m.home_id;
        kills.set(killer, (kills.get(killer) ?? 0) + 1);
      }
    }

    const any = totalCas > 0 || kills.size > 0;
    grid.hidden = !any;
    if (empty) empty.hidden = any;
    if (count) count.textContent = totalCas ? String(totalCas) : '';

    playersEl.innerHTML =
      [...byPlayer.values()]
        .sort((a, b) => b.cas - a.cas || a.player.localeCompare(b.player))
        .slice(0, 5)
        .map((p) => {
          const c = cmap.get(p.teamId);
          return (
            `<li data-open="${esc(p.teamId)}"><span class="leader-name">${ent('player', p.player)}` +
            `<small>${ent('team', c?.team_name ?? '')}</small></span><span class="leader-num">${p.cas}</span></li>`
          );
        })
        .join('') || '<li class="leader-empty">—</li>';

    killersEl.innerHTML =
      [...kills.entries()]
        .sort((a, b) => b[1] - a[1])
        .slice(0, 5)
        .map(([id, n]) => {
          const c = cmap.get(id);
          return (
            `<li data-open="${esc(id)}"><span class="leader-name">${ent('team', c?.team_name ?? id)}` +
            `<small>${ent('coach', coachLabel(id))}</small></span><span class="leader-num">${n}</span></li>`
          );
        })
        .join('') || '<li class="leader-empty">—</li>';
  }

  // -------- "Soy" / Tu partido --------
  function renderMe() {
    const sel = document.getElementById('me-select') as HTMLSelectElement | null;
    if (sel && sel.value !== me) sel.value = me;
    // refrescar etiquetas del selector con el nombre real si se conoce
    sel?.querySelectorAll('option').forEach((opt) => {
      if (!opt.value) return;
      const c = cmap.get(opt.value);
      if (c) opt.textContent = `${coachLabel(opt.value)} · ${c.team_name}`;
    });
    document.body.classList.toggle('has-me', !!me);
    renderMyMatch();
    paintList();
    paintRoundDots();
  }

  // Marca en los puntos del carrusel las rondas en las que juego
  function paintRoundDots() {
    document.querySelectorAll<HTMLElement>('.rc-dot').forEach((dot) => {
      const key = dot.dataset.round;
      const round = ROUNDS.find((r) => r.key === key);
      const playsIn =
        !!me && !!round && round.fixtures.some((f) => f.home_id === me || f.away_id === me);
      dot.classList.toggle('has-me', playsIn);
    });
  }

  function renderMyMatch() {
    const host = document.getElementById('mi-partido') as HTMLElement;
    if (!host) return;
    const fx = me
      ? CURRENT_FIXTURES.find((f) => f.home_id === me || f.away_id === me)
      : undefined;
    if (!fx || document.getElementById('sec-results')?.hidden === false) {
      host.hidden = true;
      return;
    }
    const iAmHome = fx.home_id === me;
    const myTeam = iAmHome ? fx.home_team : fx.away_team;
    const rivalId = iAmHome ? fx.away_id : fx.home_id;
    const rivalTeam = iAmHome ? fx.away_team : fx.home_team;
    const rivalRec = state.get(rivalId);
    const mrow = mstate.get(fx.id);

    let status = 'Sin agendar';
    if (mrow && (mrow.td_home != null || mrow.td_away != null)) {
      status = `Jugado · ${mrow.td_home ?? 0}–${mrow.td_away ?? 0}`;
    } else if (mrow?.scheduled_at) {
      status = 'Agendado · ' + fmtDateTime(mrow.scheduled_at);
    }

    host.querySelector<HTMLElement>('.mp-teams')!.textContent = `${myTeam}  vs  ${rivalTeam}`;
    host.querySelector<HTMLElement>('.mp-status')!.textContent = status;

    const wa = host.querySelector<HTMLAnchorElement>('.mp-wa')!;
    const rivalName = coachLabel(rivalId);
    const link = rivalRec?.whatsapp
      ? waHref(
          rivalRec.whatsapp,
          `¡Hola ${rivalName}! Soy de ${myTeam}. Nos toca en ${ROUND} de Tasting Blood VI, ¿cuándo jugamos?`,
        )
      : null;
    wa.textContent = `Escribir a ${rivalName}`;
    if (link) {
      wa.href = link;
      wa.classList.remove('disabled');
      wa.setAttribute('aria-disabled', 'false');
    } else {
      wa.removeAttribute('href');
      wa.classList.add('disabled');
      wa.setAttribute('aria-disabled', 'true');
    }
    host.querySelector<HTMLButtonElement>('.mp-open')!.onclick = () => openMatch(fx.id);
    host.hidden = false;
  }

  function esc(s: unknown): string {
    return String(s ?? '').replace(/[&<>"']/g, (m) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]!),
    );
  }

  // Enlace directo a una ficha vía #hash (sin ensuciar el historial)
  function setHash(id: string) {
    try {
      history.replaceState(null, '', '#' + encodeURIComponent(id));
    } catch {}
  }
  function clearHash() {
    if (!location.hash) return;
    try {
      history.replaceState(null, '', location.pathname + location.search);
    } catch {
      try {
        location.hash = '';
      } catch {}
    }
  }

  // Cambia el texto de un botón un momento para dar feedback
  function flash(btn: HTMLElement, txt: string) {
    const prev = btn.dataset.label ?? btn.textContent ?? '';
    btn.dataset.label = prev;
    btn.textContent = txt;
    btn.classList.add('flashed');
    window.setTimeout(() => {
      btn.textContent = btn.dataset.label ?? prev;
      btn.classList.remove('flashed');
    }, 1600);
  }

  const roundPending = new Map<string, number>();
  const roundTotal = new Map<string, number>();

  function updateRoundStatus() {
    const el = document.getElementById('round-pending');
    const countEl = document.getElementById('round-count');
    const labelEl = document.getElementById('round-carousel-label');
    const pending = roundPending.get(activeRoundKey) ?? 0;
    const total = roundTotal.get(activeRoundKey) ?? 0;
    if (labelEl) {
      labelEl.textContent = ROUNDS.find((r) => r.key === activeRoundKey)?.label ?? '';
    }
    if (countEl) countEl.textContent = total ? `${total} partidos` : '';
    if (!el) return;
    if (pending === 0 && total > 0) {
      el.textContent = 'ronda completa';
      el.dataset.tone = 'done';
    } else {
      el.textContent = `${pending} pendiente${pending === 1 ? '' : 's'}`;
      el.dataset.tone = 'pending';
    }
  }

  function paintFixtures() {
    document.querySelectorAll<HTMLElement>('.round-panel').forEach((panel) => {
      const key = panel.dataset.round!;
      const rows = panel.querySelectorAll<HTMLElement>('.fixture');
      let pending = 0;
      rows.forEach((el) => {
        const m = mstate.get(el.dataset.fixture!);
        const info = el.querySelector<HTMLElement>('.fx-info')!;
        const hasScore = m && (m.td_home != null || m.td_away != null);
        if (hasScore) {
          const h = m!.td_home ?? 0;
          const a = m!.td_away ?? 0;
          const cas =
            m!.cas_home != null || m!.cas_away != null
              ? `<span class="cas">${m!.cas_home ?? 0}–${m!.cas_away ?? 0} bajas</span>`
              : '';
          info.innerHTML =
            `<span class="score">` +
            `<span class="${h > a ? 'win' : ''}">${h}</span>` +
            `<span class="dash">–</span>` +
            `<span class="${a > h ? 'win' : ''}">${a}</span>` +
            `</span>${cas}`;
          info.dataset.kind = 'result';
          el.dataset.played = '';
        } else {
          pending++;
          delete el.dataset.played;
          if (m?.scheduled_at) {
            info.textContent = fmtDateTime(m.scheduled_at);
            info.dataset.kind = 'date';
          } else {
            info.textContent = 'agendar';
            info.dataset.kind = 'empty';
          }
        }

        // Banner de noticias: la nota manual manda; si no hay, el recap automático.
        const ticker = el.querySelector<HTMLButtonElement>('.fx-ticker');
        if (ticker) {
          const track = ticker.querySelector<HTMLElement>('.fx-ticker-track')!;
          const fxInfo = fmap.get(el.dataset.fixture!);
          const text = (m?.note?.trim() || (m && fxInfo ? matchRecap(fxInfo, m) : null) || '').trim();
          if (text) {
            track.textContent = text;
            ticker.hidden = false;
            ticker.classList.toggle('scroll', text.length > 42);
          } else {
            ticker.hidden = true;
            track.textContent = '';
            ticker.classList.remove('scroll');
          }
        }
      });
      roundPending.set(key, pending);
      roundTotal.set(key, rows.length);
    });
    updateRoundStatus();
    renderStandings();
    renderLeaders();
    renderFallen();
    renderBrutal();
    renderMyMatch();
  }

  function showRound(key: string) {
    if (!ROUNDS.some((r) => r.key === key)) return;
    activeRoundKey = key;
    document.querySelectorAll<HTMLElement>('.round-panel').forEach((p) => {
      p.hidden = p.dataset.round !== key;
    });
    document.querySelectorAll<HTMLElement>('.rc-dot').forEach((d) => {
      const active = d.dataset.round === key;
      d.classList.toggle('active', active);
      if (active) d.setAttribute('aria-current', 'true');
      else d.removeAttribute('aria-current');
    });
    updateRoundStatus();
  }

  function stepRound(delta: number) {
    const idx = ROUNDS.findIndex((r) => r.key === activeRoundKey);
    if (idx === -1) return;
    const next = ROUNDS[(idx + delta + ROUNDS.length) % ROUNDS.length];
    showRound(next.key);
  }

  document.querySelector('.rc-prev')?.addEventListener('click', () => stepRound(-1));
  document.querySelector('.rc-next')?.addEventListener('click', () => stepRound(1));
  document.getElementById('rc-dots')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.rc-dot');
    if (btn?.dataset.round) showRound(btn.dataset.round);
  });
  paintFixtures();

  // ================= Ficha de contacto =================
