  // ================= Ficha de partido =================
  const dlgMatch = document.getElementById('match') as HTMLDialogElement;
  const mq = <T extends HTMLElement>(sel: string) => dlgMatch.querySelector(sel) as T;
  const m = {
    title: mq<HTMLHeadingElement>('.m-title'),
    recap: mq<HTMLParagraphElement>('.m-recap'),
    played: mq<HTMLParagraphElement>('.m-played'),
    fumbblLink: mq<HTMLAnchorElement>('.m-fumbbl-link'),
    datetime: mq<HTMLInputElement>('.m-datetime'),
    homeLabels: dlgMatch.querySelectorAll<HTMLElement>('.m-home'),
    awayLabels: dlgMatch.querySelectorAll<HTMLElement>('.m-away'),
    tdHome: mq<HTMLInputElement>('.m-td-home'),
    tdAway: mq<HTMLInputElement>('.m-td-away'),
    casHome: mq<HTMLInputElement>('.m-cas-home'),
    casAway: mq<HTMLInputElement>('.m-cas-away'),
    note: mq<HTMLInputElement>('.m-note'),
    save: mq<HTMLButtonElement>('.m-save'),
    remindHome: mq<HTMLAnchorElement>('.m-remind-home'),
    remindAway: mq<HTMLAnchorElement>('.m-remind-away'),
    updated: mq<HTMLSpanElement>('.m-updated'),
    st: mq<HTMLSpanElement>('.m-status'),
  };
  let currentFixture: string | null = null;

  const numOrNull = (el: HTMLInputElement) =>
    el.value.trim() === '' ? null : Math.max(0, parseInt(el.value, 10) || 0);

  function refreshReminders() {
    if (!currentFixture) return;
    const fx = fmap.get(currentFixture)!;
    const whenIso = m.datetime.value ? new Date(m.datetime.value).toISOString() : null;
    const when = whenIso ? fmtDateTime(whenIso) : null;
    const base = `Recordatorio Tasting Blood VI — ${fx.home_team} vs ${fx.away_team}.`;
    const tail = when
      ? ` Quedamos el ${when}. ¡Nos vemos!`
      : ` ¿Cerramos día y hora?`;

    [
      [m.remindHome, fx.home_id],
      [m.remindAway, fx.away_id],
    ].forEach(([btn, coachId]) => {
      const a = btn as HTMLAnchorElement;
      const coach = cmap.get(coachId as string)!;
      const rec = state.get(coachId as string);
      const label = rec?.real_name || coach.fumbbl_coach;
      a.textContent = `Recordar a ${label}`;
      const link = rec?.whatsapp ? waHref(rec.whatsapp, base + tail) : null;
      if (link) {
        a.href = link;
        a.classList.remove('disabled');
        a.setAttribute('aria-disabled', 'false');
        a.title = '';
      } else {
        a.removeAttribute('href');
        a.classList.add('disabled');
        a.setAttribute('aria-disabled', 'true');
        a.title = 'Sin WhatsApp guardado para este coach';
      }
    });
  }

  function matchRecap(fx: FixtureInfo, r: MatchRow): string | null {
    if (r.td_home == null || r.td_away == null) return null;
    const h = r.td_home,
      a = r.td_away;
    const verb =
      h > a ? `${fx.home_team} venció a ${fx.away_team}` : a > h
        ? `${fx.away_team} venció a ${fx.home_team}`
        : `${fx.home_team} empató con ${fx.away_team}`;
    const casTotal = (r.cas_home ?? 0) + (r.cas_away ?? 0);
    const casTxt = casTotal > 0 ? `, con ${casTotal} baja${casTotal === 1 ? '' : 's'} en total` : '';
    const mvps = [r.mvp_home, r.mvp_away].filter(Boolean);
    const mvpTxt = mvps.length ? ` MVP: ${mvps.join(' / ')}.` : '';
    return `${verb} ${h}-${a}${casTxt}.${mvpTxt}`;
  }

  function openMatch(fixtureId: string) {
    const fx = fmap.get(fixtureId);
    if (!fx) return;
    currentFixture = fixtureId;
    m.title.textContent = `${fx.home_team} vs ${fx.away_team}`;
    m.homeLabels.forEach((el) => (el.textContent = fx.home_team));
    m.awayLabels.forEach((el) => (el.textContent = fx.away_team));
    const roundLabelEl = document.getElementById('match-round-label');
    if (roundLabelEl) {
      roundLabelEl.textContent = roundOfFixture.get(fixtureId)?.label ?? ROUND;
    }

    const r = mstate.get(fixtureId);
    m.datetime.value = toLocalInput(r?.scheduled_at ?? null);
    m.tdHome.value = r?.td_home != null ? String(r.td_home) : '';
    m.tdAway.value = r?.td_away != null ? String(r.td_away) : '';
    m.casHome.value = r?.cas_home != null ? String(r.cas_home) : '';
    m.casAway.value = r?.cas_away != null ? String(r.cas_away) : '';
    m.note.value = r?.note ?? '';

    const recap = r ? matchRecap(fx, r) : null;
    m.recap.hidden = !recap;
    m.recap.textContent = recap ?? '';

    if (r?.played_at) {
      m.played.hidden = false;
      m.played.innerHTML =
        icon('calendar') + ' Jugado el ' +
        new Date(r.played_at).toLocaleDateString('es-ES', {
          day: '2-digit',
          month: 'short',
          year: 'numeric',
        });
    } else {
      m.played.hidden = true;
