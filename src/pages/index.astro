    if (r?.fumbbl_match_id) {
      m.fumbblLink.hidden = false;
      m.fumbblLink.href = `https://fumbbl.com/p/match?id=${r.fumbbl_match_id}`;
    } else {
      m.fumbblLink.hidden = true;
    }

    m.updated.textContent = r?.updated_at
      ? 'Actualizado ' +
        new Date(r.updated_at).toLocaleDateString('es-ES', {
          day: '2-digit',
          month: 'short',
          year: 'numeric',
        })
      : 'Sin datos guardados';
    m.st.textContent = '';
    m.st.className = 'm-status';
    refreshReminders();
    if (dlg.open) dlg.close();
    if (!dlgMatch.open) dlgMatch.showModal();
    setHash(fixtureId);
