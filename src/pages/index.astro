  const secStandings = document.getElementById('sec-standings') as HTMLElement;
  const secLeaders = document.getElementById('sec-leaders') as HTMLElement;
  const secFallen = document.getElementById('sec-fallen') as HTMLElement;
  const secBrutal = document.getElementById('sec-brutal') as HTMLElement;

  function runSearch() {
    const term = search.value.toLowerCase().trim();
    if (!term) {
      secResults.hidden = true;
      secRound.hidden = false;
      secStandings.hidden = false;
      secLeaders.hidden = false;
      secFallen.hidden = false;
      secBrutal.hidden = false;
      secRoster.hidden = false;
      renderMyMatch();
      return;
    }
    const matches = COACHES.filter((c) => {
      const r = state.get(c.id);
      return (
        c.team_name +
        ' ' +
        c.fumbbl_coach +
        ' ' +
        (r?.real_name ?? '')
      )
        .toLowerCase()
        .includes(term);
    }).sort((a, b) => a.team_name.localeCompare(b.team_name, 'es'));

    resultsList.innerHTML = matches.map(rosterItemHTML).join('');
    resultsCount.textContent = String(matches.length);
    resultsEmpty.hidden = matches.length > 0;
    secResults.hidden = false;
    secRound.hidden = true;
    secStandings.hidden = true;
    secLeaders.hidden = true;
    secFallen.hidden = true;
    secBrutal.hidden = true;
    secRoster.hidden = true;
    document.getElementById('mi-partido')!.hidden = true;
    paintList();
  }

  search.addEventListener('input', runSearch);
  search.addEventListener('search', runSearch);
  resultsList.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
    if (btn) openDetail(btn.dataset.open!);
  });

  // ================= "Soy" =================
  const meSelect = document.getElementById('me-select') as HTMLSelectElement;
  meSelect.addEventListener('change', () => {
    me = meSelect.value;
    saveMe(me);
    renderMe();
    applyDetailLock();
  });

  // ================= Clasificación: click en fila =================
  document.getElementById('podium')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
    if (b) openDetail(b.dataset.open!);
  });
  document.getElementById('standings-body')!.addEventListener('click', (e) => {
    const tr = (e.target as HTMLElement).closest<HTMLElement>('tr[data-open]');
    if (tr) openDetail(tr.dataset.open!);
  });

  // ================= Líderes / Salón de los caídos: click en fila =================
  document.getElementById('sec-leaders')!.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-open]');
    if (li) openDetail(li.dataset.open!);
  });
  document.getElementById('brutal-body')!.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-open]');
    if (li) openDetail(li.dataset.open!);
  });
  document.getElementById('fallen-body')!.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-open]');
    if (li) openDetail(li.dataset.open!);
  });

  // Secciones colapsables (Líderes abierto, Salón de los caídos y Brutalistas cerrados)
  function makeCollapsible(toggleId: string, bodyId: string) {
    const toggle = document.getElementById(toggleId);
    const body = document.getElementById(bodyId);
    if (!toggle || !body) return;
    const flip = () => {
      const open = body.hidden;
      body.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('open', open);
    };
    toggle.addEventListener('click', flip);
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        flip();
      }
    });
  }
  makeCollapsible('leaders-toggle', 'leaders-body');
  makeCollapsible('fallen-toggle', 'fallen-body');
  makeCollapsible('brutal-toggle', 'brutal-body');
  makeCollapsible('standings-toggle', 'standings-wrap');
  makeCollapsible('roster-toggle', 'roster-wrap');
  (() => {
    const btn = document.getElementById('fallen-all-toggle');
    const list = document.getElementById('fallen-list');
    if (!btn || !list) return;
    btn.addEventListener('click', () => {
      const open = list.hidden;
      list.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('open', open);
    });
  })();

  function openFromHash() {
    const h = decodeURIComponent((location.hash || '').slice(1));
    if (!h) return;
    if (fmap.has(h)) openMatch(h);
    else if (cmap.has(h)) openDetail(h);
  }

  async function load() {
    if (!supabase) return;
    const [coachesRes, matchesRes, fsRes] = await Promise.all([
      supabase.from('coaches').select('id, real_name, whatsapp, notes, updated_at'),
      supabase
        .from('matches')
        .select(
          'id, round, home_id, away_id, home_team, away_team, scheduled_at, td_home, td_away, cas_home, cas_away, comp_home, comp_away, mvp_home, mvp_away, played_at, fumbbl_match_id, casualties, bashers, note, updated_at',
        ),
      supabase.from('fumbbl_standings').select('*'),
    ]);
    if (!fsRes.error) {
      fumbblStandings = (fsRes.data ?? []) as FStand[];
    }

    if (coachesRes.error) {
      banner.hidden = false;
      banner.textContent =
        'No se pudieron cargar los contactos: ' + coachesRes.error.message;
    } else {
      (coachesRes.data ?? []).forEach((r: Row) => state.set(r.id, r));
      paintList();
    }

    if (matchesRes.error) {
      // La tabla puede no existir todavía (matches.sql sin ejecutar): aviso suave.
      banner.hidden = false;
      banner.innerHTML =
        'Los contactos funcionan. Para día/hora y resultado, ejecuta <code>supabase/matches.sql</code> en Supabase. (' +
        matchesRes.error.message +
        ')';
    } else {
      (matchesRes.data ?? []).forEach((r: MatchRow) => mstate.set(r.id, r));
      paintFixtures();
    }

    renderStandings();
    renderMe();

    if (currentId) openDetail(currentId);
    if (currentFixture) openMatch(currentFixture);
    if (search.value.trim()) runSearch();
    else openFromHash();
  }

  renderMe();
  openFromHash();
  load();
</script>
