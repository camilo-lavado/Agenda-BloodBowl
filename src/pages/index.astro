      note.innerHTML =
        icon('lock') +
        ' ' +
        (me === ''
          ? 'Elige tu coach en «Soy» (arriba) para poder editar tu ficha.'
          : `Solo ${esc(who)} o Camilo pueden editar esta ficha.`);
