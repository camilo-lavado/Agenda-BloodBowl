  function rosterItemHTML(c: CoachInfo): string {
    const r = state.get(c.id);
    const name = r?.real_name || c.fumbbl_coach;
    return (
      `<li><button class="roster-item" type="button" data-id="${esc(c.id)}" data-open="${esc(c.id)}">` +
      `<span class="status-dot" data-state="${statusOf(c.id)}" aria-hidden="true"></span>` +
